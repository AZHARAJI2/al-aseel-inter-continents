# ===== Al-Aseel Website — Netlify Environment Variables =====
# Copy this file to .env and fill in the values, then add them in Netlify Dashboard > Site Settings > Environment Variables

# Google Sheets
SHEET_ID=your_google_sheet_id_here

# Google Apps Script Web App URL (for admin operations)
APPS_SCRIPT_WEB_APP_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# Google Gemini API Key (for AI agent)
GEMINI_API_KEY=your_gemini_api_key_here

# Admin Authentication
ADMIN_PASSWORD=your_secure_password_here
ADMIN_SECRET=your_secure_secret_token_here
